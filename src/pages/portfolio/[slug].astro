---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map((study) => ({
    params: { slug: study.id.replace(/\.md$/, '') },
    props: { study },
  }));
}

const { study } = Astro.props;
const { data } = study;
---

<Layout
  title={`${data.title} - Your Agency`}
  description={data.outcome}
>
  <main class="min-h-screen bg-[#050507]">
    <!-- Hero Section -->
    <section
      class="py-20 px-6"
      aria-labelledby="case-study-heading"
    >
      <div class="max-w-6xl mx-auto">
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex items-center space-x-2 text-sm text-gray-400">
            <li>
              <a href="/" class="hover:text-blue-400 transition-colors duration-150">Home</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/portfolio" class="hover:text-blue-400 transition-colors duration-150">Portfolio</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-white" aria-current="page">{data.title}</li>
          </ol>
        </nav>
        <h1
          id="case-study-heading"
          class="text-4xl md:text-5xl font-bold text-white mb-6"
        >
          {data.title}
        </h1>
        <div class="flex flex-wrap gap-4 mb-8">
          <span class="px-3 py-1 bg-blue-600/20 text-blue-400 rounded-full text-sm">
            {data.client}
          </span>
          <span class="px-3 py-1 bg-gray-700 text-gray-300 rounded-full text-sm">
            {data.industry}
          </span>
          <span class="px-3 py-1 bg-gray-700 text-gray-300 rounded-full text-sm">
            {data.service}
          </span>
        </div>
        <div class="bg-green-600/20 border border-green-600/30 rounded-xl p-6 inline-block">
          <p class="text-green-400 text-2xl font-bold">{data.resultMetric}</p>
        </div>
      </div>
    </section>

    <!-- Case Study Content -->
    <section
      class="py-12 px-6"
      aria-labelledby="content-heading"
    >
      <div class="max-w-4xl mx-auto prose prose-invert">
        <h2 id="content-heading" class="sr-only">
          Case Study Details
        </h2>
        <study.Content />
      </div>
    </section>

    <!-- CTA Section -->
    <section
      class="py-20 px-6"
      aria-labelledby="cta-heading"
    >
      <div class="max-w-4xl mx-auto text-center bg-[#111111] border border-white/10 rounded-xl p-12">
        <h2 id="cta-heading" class="text-3xl font-bold text-white mb-4">
          Want Similar Results?
        </h2>
        <p class="text-gray-400 mb-8">
          Contact us to discuss how we can help you achieve similar success with your digital marketing.
        </p>
        <a
          href="/contact"
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-8 py-3 rounded-lg transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-[#111111]"
        >
          Start Your Project
        </a>
      </div>
    </section>
  </main>
</Layout>
