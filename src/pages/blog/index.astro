---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.data.locale === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog - Your Agency">
  <main class="min-h-screen">
    <section class="px-6 py-20">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-12">Blog</h1>
        
        <div class="space-y-12">
          {posts.map((post) => (
            <article class="border-b border-gray-200 pb-12">
              <div class="mb-4">
                {post.data.category && (
                  <span class="inline-block px-3 py-1 bg-blue-100 text-blue-800 text-sm rounded-full">
                    {post.data.category}
                  </span>
                )}
              </div>
              
              <h2 class="text-2xl md:text-3xl font-bold mb-3">
                <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition">
                  {post.data.title}
                </a>
              </h2>
              
              <p class="text-gray-600 mb-4">{post.data.description}</p>
              
              <div class="flex items-center gap-4 text-sm text-gray-500">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                
                {post.data.tags.length > 0 && (
                  <div class="flex gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="text-gray-400">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
        
        {posts.length === 0 && (
          <p class="text-gray-600 text-center py-12">No blog posts yet. Check back soon!</p>
        )}
      </div>
    </section>
  </main>
</Layout>
