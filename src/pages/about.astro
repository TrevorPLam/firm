---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - Your Agency">
  <main class="min-h-screen">
    <section class="px-6 py-20" aria-labelledby="about-heading">
      <div class="max-w-4xl mx-auto">
        <h1 id="about-heading" class="text-4xl md:text-5xl font-bold mb-8">About Us</h1>

        <div class="prose prose-lg max-w-none">
          <p class="text-xl text-gray-600 mb-8">
            We are a digital marketing agency dedicated to helping businesses grow and succeed in the digital landscape.
          </p>

          <h2 class="text-2xl font-bold mt-12 mb-4">Our Mission</h2>
          <p class="text-gray-600 mb-6">
            To deliver exceptional digital marketing solutions that drive measurable results for our clients. We believe in data-driven strategies combined with creative excellence.
          </p>

          <h2 class="text-2xl font-bold mt-12 mb-4">Our Values</h2>
          <ul class="list-disc pl-6 text-gray-600 space-y-2">
            <li>Transparency in all our dealings</li>
            <li>Commitment to client success</li>
            <li>Continuous innovation and learning</li>
            <li>Collaborative approach to partnerships</li>
          </ul>

          <h2 class="text-2xl font-bold mt-12 mb-4">Our Team</h2>
          <p class="text-gray-600 mb-6">
            Our team consists of experienced digital marketers, content strategists, SEO specialists, and creative professionals who are passionate about delivering results.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
