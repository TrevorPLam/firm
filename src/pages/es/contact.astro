---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contacto - Tu Agencia">
  <main class="min-h-screen">
    <section class="px-6 py-20" aria-labelledby="contact-heading">
      <div class="max-w-2xl mx-auto">
        <h1 id="contact-heading" class="text-4xl md:text-5xl font-bold mb-8">Contacto</h1>

        <p class="text-xl text-gray-600 mb-12">
          Ponte en contacto con nosotros para discutir tus necesidades de marketing digital
        </p>

        <form
          action="/api/contact"
          method="POST"
          class="space-y-6"
          novalidate
        >
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              Nombre <span class="text-red-500" aria-label="required">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              aria-required="true"
              aria-describedby="name-error"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent focus:outline-none transition-colors duration-150"
              placeholder="Tu nombre"
            />
            <p id="name-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Correo Electrónico <span class="text-red-500" aria-label="required">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              aria-required="true"
              aria-describedby="email-error"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent focus:outline-none transition-colors duration-150"
              placeholder="tu@correo.com"
            />
            <p id="email-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
              Asunto <span class="text-red-500" aria-label="required">*</span>
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              aria-required="true"
              aria-describedby="subject-error"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent focus:outline-none transition-colors duration-150"
              placeholder="¿Cómo podemos ayudarte?"
            />
            <p id="subject-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
              Mensaje <span class="text-red-500" aria-label="required">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              aria-required="true"
              aria-describedby="message-error"
              rows="5"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent focus:outline-none transition-colors duration-150 resize-y"
              placeholder="Cuéntanos sobre tu proyecto..."
            ></textarea>
            <p id="message-error" class="mt-1 text-sm text-red-600 hidden" role="alert"></p>
          </div>

          <button
            type="submit"
            class="w-full px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition-colors duration-150 font-medium"
          >
            Enviar Mensaje
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>
