---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const services = allServices
  .sort((a, b) => a.data.order - b.data.order)
  .map((service) => ({
    ...service,
    slug: service.id.replace(/\.md$/, ''),
  }));
---

<Layout
  title="Services - Your Agency"
  description="Comprehensive digital marketing services including SEO, content marketing, social media, PPC, and more"
>
  <main class="min-h-screen bg-[#050507]">
    <!-- Hero Section -->
    <section
      class="py-20 px-6"
      aria-labelledby="services-heading"
    >
      <div class="max-w-6xl mx-auto text-center">
        <h1
          id="services-heading"
          class="text-4xl md:text-5xl font-bold text-white mb-6"
        >
          Our Services
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto mb-8">
          Comprehensive digital marketing solutions tailored to help your business grow. From SEO to social media, we have the expertise to drive results.
        </p>
      </div>
    </section>

    <!-- Services Grid -->
    <section
      class="py-12 px-6"
      aria-labelledby="services-list-heading"
    >
      <div class="max-w-6xl mx-auto">
        <h2 id="services-list-heading" class="sr-only">
          List of Services
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              icon={service.data.icon}
              slug={service.slug}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section
      class="py-20 px-6"
      aria-labelledby="cta-heading"
    >
      <div class="max-w-4xl mx-auto text-center bg-[#111111] border border-white/10 rounded-xl p-12">
        <h2 id="cta-heading" class="text-3xl font-bold text-white mb-4">
          Ready to Grow Your Business?
        </h2>
        <p class="text-gray-400 mb-8">
          Contact us today to discuss how our services can help you achieve your marketing goals.
        </p>
        <a
          href="/contact"
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-8 py-3 rounded-lg transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-[#111111]"
        >
          Get in Touch
        </a>
      </div>
    </section>
  </main>
</Layout>
