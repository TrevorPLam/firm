---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Your Agency">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="px-6 py-20 md:py-32">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6">
          Digital Marketing Excellence
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto">
          We help businesses grow through strategic digital marketing solutions
        </p>
        <div class="flex gap-4 justify-center">
          <a href="/contact" class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
            Get Started
          </a>
          <a href="/about" class="px-8 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition">
            Learn More
          </a>
        </div>
      </div>
    </section>

    <!-- Services Preview -->
    <section class="px-6 py-20 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Our Services</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-6 bg-white rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-3">SEO Optimization</h3>
            <p class="text-gray-600">Improve your search rankings and drive organic traffic</p>
          </div>
          <div class="p-6 bg-white rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-3">Content Marketing</h3>
            <p class="text-gray-600">Engaging content that resonates with your audience</p>
          </div>
          <div class="p-6 bg-white rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-3">Social Media</h3>
            <p class="text-gray-600">Build your brand presence across all platforms</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
