---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
// TODO: When adding hero images, use Astro Image component:
// import { Image } from 'astro:assets';
// <Image src="/hero.jpg" alt="Hero" width={1200} height={600} loading="eager" />

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Your Agency",
  url: new URL("/", Astro.site).href,
  description: "Digital Marketing Excellence",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: new URL("/search?q={search_term_string}", Astro.site).href,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<Layout 
  title="Home - Your Agency"
  schema={webSiteSchema}
>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="px-6 py-20 md:py-32 relative overflow-hidden" aria-labelledby="hero-heading">
      <!-- Hero Visual: Gradient Background Pattern -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-white to-gray-50"></div>
        <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 2px 2px, rgba(0, 102, 255, 0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
      </div>
      <div class="max-w-6xl mx-auto text-center relative">
        <h1 id="hero-heading" class="text-5xl md:text-7xl font-bold mb-6">
          Grow Your Business with Data-Driven Digital Marketing
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-3xl mx-auto">
          We help ambitious businesses scale through strategic, measurable digital marketing that delivers real results
        </p>
        <div class="flex gap-4 justify-center">
          <a
            href="/contact"
            class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition-colors duration-150"
          >
            Get Started
          </a>
          <a
            href="/about"
            class="px-8 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition-colors duration-150"
          >
            Learn More
          </a>
        </div>
      </div>
    </section>

    <!-- Services Preview -->
    <section class="px-6 py-20 bg-gray-50" aria-labelledby="services-heading">
      <div class="max-w-6xl mx-auto">
        <h2 id="services-heading" class="text-3xl md:text-4xl font-bold text-center mb-12">Our Services</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <article class="p-6 bg-white rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-3">SEO Optimization</h3>
            <p class="text-gray-600">Improve your search rankings and drive organic traffic</p>
          </article>
          <article class="p-6 bg-white rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-3">Content Marketing</h3>
            <p class="text-gray-600">Engaging content that resonates with your audience</p>
          </article>
          <article class="p-6 bg-white rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-3">Social Media</h3>
            <p class="text-gray-600">Build your brand presence across all platforms</p>
          </article>
        </div>
      </div>
    </section>

    <!-- What You've Done: Case Studies -->
    <section class="px-6 py-20" aria-labelledby="casestudies-heading">
      <div class="max-w-6xl mx-auto">
        <h2 id="casestudies-heading" class="text-3xl md:text-4xl font-bold text-center mb-4">Featured Case Studies</h2>
        <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">See how we've helped businesses achieve remarkable results through data-driven digital marketing strategies.</p>
        <div class="grid md:grid-cols-2 gap-8">
          <article class="p-6 bg-[#111111] border border-white/10 rounded-xl" role="article" aria-label="Case study: TechCorp SaaS - 250% increase in organic traffic">
            <div class="mb-4">
              <span class="text-sm text-gray-400">TechCorp SaaS</span>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-white">Scaling Organic Growth for B2B SaaS</h3>
            <p class="text-gray-300 mb-4">Challenge: Low search visibility and stagnant organic traffic in a competitive market.</p>
            <div class="mb-4">
              <span class="text-2xl font-bold text-blue-400">250%</span>
              <span class="text-gray-400 ml-2">increase in organic traffic</span>
            </div>
            <a
              href="/portfolio/techcorp-saas"
              class="inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 focus:ring-offset-[#111111] transition-colors duration-150"
            >
              View Case Study
            </a>
          </article>
          <article class="p-6 bg-[#111111] border border-white/10 rounded-xl" role="article" aria-label="Case study: RetailBrand E-commerce - 180% increase in conversion rate">
            <div class="mb-4">
              <span class="text-sm text-gray-400">RetailBrand E-commerce</span>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-white">Driving Conversions for Retail Brand</h3>
            <p class="text-gray-300 mb-4">Challenge: High traffic but low conversion rates on product pages.</p>
            <div class="mb-4">
              <span class="text-2xl font-bold text-blue-400">180%</span>
              <span class="text-gray-400 ml-2">increase in conversion rate</span>
            </div>
            <a
              href="/portfolio/retailbrand-ecommerce"
              class="inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 focus:ring-offset-[#111111] transition-colors duration-150"
            >
              View Case Study
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- What Your Clients Say: Testimonials -->
    <section class="px-6 py-20 bg-gray-50" aria-labelledby="testimonials-heading">
      <div class="max-w-6xl mx-auto">
        <h2 id="testimonials-heading" class="text-3xl md:text-4xl font-bold text-center mb-4">What Our Clients Say</h2>
        <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">Don't just take our word for it. Here's what our clients have to say about working with us.</p>
        <div class="grid md:grid-cols-3 gap-8">
          <figure class="p-6 bg-[#111111] border border-white/10 rounded-xl" role="figure" aria-label="Testimonial from Sarah Johnson, CEO at TechCorp">
            <blockquote class="mb-4">
              <p class="text-gray-300 italic">"Working with this team transformed our digital presence. Their data-driven approach helped us triple our organic traffic in just six months."</p>
            </blockquote>
            <figcaption class="text-sm">
              <div class="font-semibold text-white">Sarah Johnson</div>
              <div class="text-gray-400">CEO, TechCorp</div>
            </figcaption>
          </figure>
          <figure class="p-6 bg-[#111111] border border-white/10 rounded-xl" role="figure" aria-label="Testimonial from Michael Chen, Marketing Director at RetailBrand">
            <blockquote class="mb-4">
              <p class="text-gray-300 italic">"The results speak for themselves. Our conversion rates increased by 180% and we've seen a significant boost in qualified leads."</p>
            </blockquote>
            <figcaption class="text-sm">
              <div class="font-semibold text-white">Michael Chen</div>
              <div class="text-gray-400">Marketing Director, RetailBrand</div>
            </figcaption>
          </figure>
          <figure class="p-6 bg-[#111111] border border-white/10 rounded-xl" role="figure" aria-label="Testimonial from Emily Rodriguez, Founder at StartupXYZ">
            <blockquote class="mb-4">
              <p class="text-gray-300 italic">"Professional, responsive, and results-oriented. They understood our unique challenges and delivered a tailored strategy that actually worked."</p>
            </blockquote>
            <figcaption class="text-sm">
              <div class="font-semibold text-white">Emily Rodriguez</div>
              <div class="text-gray-400">Founder, StartupXYZ</div>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- What You Say: Blog Posts -->
    <section class="px-6 py-20" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto">
        <h2 id="blog-heading" class="text-3xl md:text-4xl font-bold text-center mb-4">Latest Insights</h2>
        <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">Stay ahead with our latest thought leadership on digital marketing trends and strategies.</p>
        <div class="grid md:grid-cols-3 gap-8">
          {recentPosts.map((post) => (
            <article class="p-6 bg-[#111111] border border-white/10 rounded-xl" role="article" aria-label={`Blog post: ${post.data.title}`}>
              <div class="mb-3">
                {post.data.category && (
                  <span class="text-xs text-blue-400 font-medium uppercase tracking-wide">{post.data.category}</span>
                )}
              </div>
              <h3 class="text-xl font-semibold mb-3 text-white line-clamp-2">{post.data.title}</h3>
              <p class="text-gray-300 mb-4 line-clamp-2">{post.data.description}</p>
              <div class="flex items-center justify-between">
                <time class="text-sm text-gray-400" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <a
                  href={`/blog/${post.id}`}
                  class="text-sm text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 focus:ring-offset-[#111111] transition-colors duration-150"
                >
                  Read More →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
