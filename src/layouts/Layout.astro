---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  locale?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description = "Your Agency - Digital Marketing Excellence",
  image = "/og-image.jpg",
  locale = "en",
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Base organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Your Agency",
  url: Astro.site,
  logo: new URL("/favicon.svg", Astro.site),
  description: "Digital Marketing Excellence",
  sameAs: [
    "https://twitter.com/youragency",
    "https://linkedin.com/company/youragency",
    "https://github.com/youragency",
  ],
};

// Merge base schema with page-specific schema
const finalSchema = schema
  ? { ...organizationSchema, ...schema }
  : organizationSchema;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Performance: Preconnect to external domains -->
    {import.meta.env.PUBLIC_GA_ID && (
      <link rel="preconnect" href="https://www.googletagmanager.com" />
    )}
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="og:title" content={title} />
    <meta name="og:description" content={description} />
    <meta name="og:image" content={new URL(image, Astro.site)} />
    <meta name="og:type" content="website" />
    <meta name="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <!-- Google Analytics -->
    {import.meta.env.PUBLIC_GA_ID && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}
      ></script>
    )}
    {import.meta.env.PUBLIC_GA_ID && (
      <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
    
    <!-- Structured Data -->
    <StructuredData schema={finalSchema} />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <Navigation siteName="Your Agency" currentLocale={locale} />
    <slot />
    <Footer siteName="Your Agency" />
  </body>
</html>
