---
interface Props {
  name: string;
  company: string;
  position: string;
  quote: string;
  caseStudySlug?: string;
  photo?: string;
}

const { name, company, position, quote, caseStudySlug, photo } = Astro.props;

const ariaLabel = `Testimonial from ${name}, ${position} at ${company}`;
---

<figure
  class="relative bg-[#111111] border border-white/10 rounded-xl p-6 transition-colors duration-150 hover:border-blue-500/50 focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2 focus-within:ring-offset-[#050507]"
  role="figure"
  aria-label={ariaLabel}
>
  <div class="flex flex-col h-full">
    <!-- Quote -->
    <blockquote class="flex-grow mb-4">
      <p class="text-gray-300 italic text-lg leading-relaxed">"{quote}"</p>
    </blockquote>

    <!-- Attribution -->
    <figcaption class="flex items-start gap-4">
      {photo ? (
        <img
          src={photo}
          alt={`${name} photo`}
          class="w-12 h-12 rounded-full object-cover flex-shrink-0"
          loading="lazy"
        />
      ) : null}

      <div class="flex-grow">
        <p class="text-white font-semibold">{name}</p>
        <p class="text-sm text-gray-400">{position}</p>
        <p class="text-sm text-gray-500">{company}</p>
      </div>

      {caseStudySlug ? (
        <a
          href={`/portfolio/${caseStudySlug}`}
          class="inline-flex items-center text-sm font-medium text-blue-400 hover:text-blue-300 transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-[#050507] rounded"
          aria-label={`View case study for ${name}`}
        >
          View Case Study
          <svg
            class="ml-2 w-4 h-4 transition-transform duration-150 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      ) : null}
    </figcaption>
  </div>
</figure>
