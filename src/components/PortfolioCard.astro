---
interface Props {
  title: string;
  client: string;
  industry: string;
  outcome: string;
  resultMetric: string;
  heroImage?: string;
  slug: string;
}

const { title, client, industry, outcome, resultMetric, heroImage, slug } = Astro.props;
---

<article
  class="bg-[#111111] border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-[#111111]"
  role="article"
  aria-label={`${title} case study for ${client}`}
>
  <a href={`/portfolio/${slug}`} class="block h-full" aria-label={`View ${title} case study`}>
    <div class="mb-4">
      <span class="text-sm text-blue-400 font-medium">{industry}</span>
    </div>
    <h3 class="text-xl font-semibold text-white mb-2">{title}</h3>
    <p class="text-gray-400 text-sm mb-2">{client}</p>
    <p class="text-gray-300 mb-4 line-clamp-2">{outcome}</p>
    <div class="flex items-center justify-between pt-4 border-t border-white/10">
      <span class="text-green-400 font-semibold text-sm">{resultMetric}</span>
      <span class="text-blue-400 font-medium text-sm inline-flex items-center group">
        View Case Study
        <svg
          class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-150"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </span>
    </div>
  </a>
</article>
