---
interface Props {
  title: string;
  description: string;
  icon?: string;
  slug: string;
}

const { title, description, icon, slug } = Astro.props;
---

<article
  class="bg-[#111111] border border-white/10 rounded-xl p-6 hover:border-blue-500/50 transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-[#111111]"
  role="article"
  aria-label={`${title} service`}
>
  <a href={`/services/${slug}`} class="block h-full" aria-label={`Learn more about ${title}`}>
    {icon && (
      <div class="mb-4">
        <span class="text-3xl" aria-hidden="true">{icon}</span>
      </div>
    )}
    <h3 class="text-xl font-semibold text-white mb-2">{title}</h3>
    <p class="text-gray-400 mb-4 line-clamp-3">{description}</p>
    <span class="text-blue-400 font-medium inline-flex items-center group">
      Learn More
      <svg
        class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-150"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"
        />
      </svg>
    </span>
  </a>
</article>
